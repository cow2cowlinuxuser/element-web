.mx_CallView {
    flex-grow: 1;
    min-height: 0;

    display: flex;
    flex-direction: column;

    background-color: $header-panel-bg-color;

    .mx_AppTile {
        width: auto;
        height: 100%;
        border: none;
        border-radius: inherit;
        background-color: $call-background;
    }
}

.mx_RoomView_callSplit {
    position: relative;
    display: flex;
    flex-direction: row;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.mx_RoomView_callChatPane {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
}

.mx_RoomView_callVoicePane {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    min-width: 220px;
    max-width: 75%;
    min-height: 0;
    border-left: 1px solid var(--cpd-color-border-interactive-secondary);
    background-color: $header-panel-bg-color;
}

.mx_RoomView_callVoicePane--collapsed {
    width: 0 !important;
    min-width: 0 !important;
    max-width: 0 !important;
    overflow: hidden !important;
    border-left: none !important;
    opacity: 0 !important;
    pointer-events: none !important;
}

.mx_RoomView_callVoicePane_edge {
    position: relative;
    flex: 0 0 0;
    width: 0;
    z-index: 120;
}

.mx_RoomView_callVoicePane_collapseBtn {
    position: absolute;
    top: 12px;
    right: 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    padding: 0 9px;
    border-radius: 6px 0 0 6px;
    border: 1.5px solid #58cfc9;
    border-right: none;
    background: linear-gradient(180deg, rgb(12, 58, 68, 0.95) 0%, rgb(4, 22, 28, 0.98) 100%);
    color: #e6f7f6;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: -3px 4px 14px rgb(0 0 0 / 65%);
    transition:
        background 0.14s ease,
        border-color 0.14s ease,
        color 0.14s ease;

    &:hover {
        border-color: #ffd470;
        color: #ffd470;
        background: linear-gradient(180deg, rgb(22, 78, 92, 0.98) 0%, rgb(8, 34, 42, 0.98) 100%);
    }
}

.mx_RoomView_callVoicePane_collapseBtn--collapsed {
    border-color: #ffd470;
    color: #ffd470;
}

.mx_RoomView_callVoicePane_resizer {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-height: 0;

    .mx_ResizeHandle--horizontal {
        z-index: 100;

        &::before {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            height: 56px;
            width: 4px;
            border-radius: 4px;
            content: "";
            background-color: var(--cpd-color-border-interactive-primary);
            opacity: 0.45;
            transition:
                opacity 0.15s ease,
                background-color 0.15s ease;
        }

        &:hover::before {
            background-color: $primary-content;
            opacity: 0.95;
        }
    }

    &:hover .mx_ResizeHandle--horizontal::before {
        opacity: 0.8;
    }
}

.mx_CallView_overlayBackdrop {
    position: absolute;
    inset: 0;
    z-index: 90;
    background-color: rgb(0 0 0 / 55%);
    backdrop-filter: blur(4px);
}

.mx_CallView_floatingOverlay {
    position: absolute;
    inset: 24px;
    z-index: 100;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--cpd-color-border-interactive-primary);
    box-shadow: 0 24px 64px rgb(0 0 0 / 65%);
}
